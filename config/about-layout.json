            "label": "Footer text",
            "group": "Quality standards"
        },
        "page_about_layout_why_trust_us_08": {
            "value": "100% Flavor Guarantee",
            "label": "Title",
            "group": "Guarantee"
        },
        "page_about_layout_guarantee_description": {
            "value": "We stand behind every small batch we brew. If you pop open your jar and aren't completely thrilled by the crunch, fragrance, and heat balance, we will replace it or issue a 100% full refund — no questions asked.",
            "label": "Description",
            "group": "Guarantee",
            "parts": [
                "page_about_layout_why_trust_us_07",
                "page_about_layout_why_trust_us_06",
                "page_about_layout_why_trust_us_05"
            ],
            "suffix": "",
            "type": "textarea"
        },
        "page_about_layout_why_trust_us_07": {
            "value": "We stand behind every small batch we brew. If you pop open your jar and aren't completely thrilled by the crunch, fragrance, and heat balance, we will replace it or issue a",
            "label": "We stand behind every small batch we brew. If you pop open your jar and are…",
