        },
        "page_about_layout_what_we_do_08": {
            "value": "SIGNATURE · UMAMI BOMB",
            "label": "Badge",
            "group": "Product card 2"
        },
        "page_about_layout_what_we_do_07": {
            "value": "Artisanal Umami Shrimp Chili",
            "label": "Product name",
            "group": "Product card 2"
        },
        "page_about_layout_what_we_do_06": {
            "value": "Rich, slow-simmered dried shrimp folded into ruby-red aromatic oil. The soulful backbone for broths, hotpots, and seafood dips.",
            "label": "Description",
            "group": "Product card 2"
        },
        "page_about_layout_what_we_do_05": {
