        "page_about_layout_who_we_are_15": {
            "value": "WHO WE ARE · OUR IDENTITY",
            "label": "Small label",
            "group": "Heading"
        },
        "page_about_layout_who_we_are_14": {
            "value": "Small-Kitchen Artisans",
