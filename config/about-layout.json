        "page_about_layout_what_we_do_30": {
            "value": "WHAT WE DO · OUR CRAFT",
            "label": "Small label",
            "group": "Heading"
        },
        "page_about_layout_what_we_do_29": {
            "value": "Handcrafted In Small Batches",
            "label": "Title - first line",
            "group": "Heading"
        },
        "page_about_layout_what_we_do_28": {
            "value": "Fresh, Pure & Crunchy To The Very Last Spoon",
            "label": "Title - second line",
            "group": "Heading"
        },
        "page_about_layout_what_we_do_27": {
            "value": "We turn sun-ripened chillies into pantry essentials that elevate everything from late-night ramen and crispy fried eggs to family holiday feasts.",
            "label": "Introduction",
            "group": "Heading"
        },
        "page_about_layout_what_we_do_26": {
            "value": "STEP 01",
            "label": "Step label",
            "group": "Process step 1"
        },
        "page_about_layout_what_we_do_25": {
            "value": "Sun-Ripened Selection",
            "label": "Title",
            "group": "Process step 1"
        },
        "page_about_layout_what_we_do_24": {
            "value": "We harvest only uniformly ripe chillies from clean agricultural partners, naturally sun-drying them to concentrate their volatile essential oils and distinctive fiery aroma.",
            "label": "Description",
            "group": "Process step 1"
        },
        "page_about_layout_what_we_do_23": {
            "value": "STEP 02",
            "label": "Step label",
            "group": "Process step 2"
        },
        "page_about_layout_what_we_do_22": {
            "value": "Roasting & Stone Crushing",
            "label": "Title",
            "group": "Process step 2"
        },
        "page_about_layout_what_we_do_21": {
            "value": "Chillies are gently roasted over low embers to release deep smoky notes, then coarsely crushed using traditional stone mills to preserve light, crispy flakes instead of powdery dust.",
            "label": "Description",
            "group": "Process step 2"
        },
        "page_about_layout_what_we_do_20": {
            "value": "STEP 03",
            "label": "Step label",
            "group": "Process step 3"
        },
        "page_about_layout_what_we_do_19": {
            "value": "Crispy Garlic & Dried Shrimp",
            "label": "Title",
            "group": "Process step 3"
        },
        "page_about_layout_what_we_do_18": {
            "value": "Whole garlic cloves are slow-fried to golden crunchiness in clean vegetable oil, blended with premium sun-dried shrimp for deep natural umami that lingers on the palate.",
            "label": "Description",
            "group": "Process step 3"
        },
        "page_about_layout_what_we_do_17": {
            "value": "STEP 04",
            "label": "Step label",
            "group": "Process step 4"
        },
        "page_about_layout_what_we_do_16": {
            "value": "Small-Batch Sealing",
            "label": "Title",
            "group": "Process step 4"
        },
        "page_about_layout_what_we_do_15": {
            "value": "Every glass jar is heat-sterilized, hot-filled in limited runs under 200 jars, and vacuum-sealed to lock in crunch and peak freshness for months without artificial additives.",
            "label": "Description",
            "group": "Process step 4"
        },
        "page_about_layout_what_we_do_14": {
            "value": "Our 3 Signature Product Lines",
            "label": "Title",
            "group": "Product showcase"
        },
        "page_about_layout_what_we_do_13": {
            "value": "Each crafted with a distinct personality to complete your culinary pantry",
            "label": "Introduction",
            "group": "Product showcase"
        },
        "page_about_layout_what_we_do_12": {
            "value": "BESTSELLER · TOP 1",
            "label": "Badge",
            "group": "Product card 1"
        },
        "page_about_layout_what_we_do_11": {
            "value": "Crispy Garlic Chili Crisp",
            "label": "Product name",
            "group": "Product card 1"
        },
        "page_about_layout_what_we_do_10": {
            "value": "Mellow warmth, addictive garlic crunch, and savory oil. The ultimate spoonable topping for noodles, warm rice, dumplings, and sunny-side eggs.",
            "label": "Description",
            "group": "Product card 1"
        },
        "page_about_layout_what_we_do_09": {
            "value": "Explore this blend →",
            "label": "Button text",
