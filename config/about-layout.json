            "label": "100% full refund",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_why_trust_us_05": {
            "value": "— no questions asked.",
            "label": "— no questions asked.",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_why_trust_us_04": {
            "value": "7-Day Hassle-Free Satisfaction Guarantee",
            "label": "Footer text",
            "group": "Guarantee"
        },
        "page_about_layout_why_trust_us_03": {
            "value": "As a professional chef, I am notoriously strict with oil-based condiments. Dried Chili won me over completely: the garlic is genuinely crisp as if straight from the wok, the roasted chillies have a warm smoky depth without stinging your throat, and the shrimp leaves a savory sweet umami finish. It is a permanent fixture in my kitchen.",
            "label": "Review",
            "group": "Customer testimonial"
        },
        "page_about_layout_why_trust_us_02": {
            "value": "Chef Minh Quan Le",
            "label": "Customer name",
