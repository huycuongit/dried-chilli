            "group": "Heading"
        },
        "page_about_layout_identity_lead": {
            "value": "Dried Chili (born out of the Jojo Little Kitchen family) didn't start in an industrial laboratory or an automated packaging line. We started at the family stove, driven by an uncompromising love for authentic Asian spice craftsmanship.",
            "label": "Story paragraph 1",
            "group": "Our story",
            "parts": [
                "page_about_layout_who_we_are_12",
                "page_about_layout_who_we_are_11",
                "page_about_layout_who_we_are_10",
                "page_about_layout_who_we_are_09"
            ],
            "suffix": "",
            "type": "textarea"
        },
        "page_about_layout_who_we_are_12": {
            "value": "Dried Chili",
            "label": "Dried Chili",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_who_we_are_11": {
            "value": "(born out of the",
            "label": "(born out of the",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_who_we_are_10": {
            "value": "Jojo Little Kitchen",
            "label": "Jojo Little Kitchen",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_who_we_are_09": {
            "value": "family) didn't start in an industrial laboratory or an automated packaging line. We started at the family stove, driven by an uncompromising love for authentic Asian spice craftsmanship.",
            "label": "family) didn't start in an industrial laboratory or an automated packaging …",
            "editor_hidden": true,
            "group": "Section settings"
        },
        "page_about_layout_who_we_are_08": {
            "value": "Years ago, we grew tired of mainstream supermarket chilli oils loaded with artificial preservatives, synthetic colorants, and the cloying sweetness of flavor enhancers. Real heat — that fragrant, smoky warmth of sun-dried chillies that gently warms your palate and awakens every sense — had been lost in the pursuit of mass manufacturing.",
            "label": "Story paragraph 2",
            "group": "Our story"
        },
        "page_about_layout_who_we_are_07": {
            "value": "We chose to return to the source: tracking down heirloom chilli varieties, honoring the slow-roasting techniques passed down by our grandmothers, and perfecting every step to meet the uncompromising standards of modern food lovers.",
            "label": "Story paragraph 3",
            "group": "Our story"
        },
        "page_about_layout_who_we_are_06": {
            "value": "Chef-Crafted Recipes",
            "label": "Highlight 1 - title",
            "group": "Highlights"
        },
        "page_about_layout_who_we_are_05": {
            "value": "Every formulation is refined through hundreds of kitchen tastings to achieve the golden balance of Heat, Crunch, and Umami.",
            "label": "Highlight 1 - description",
            "group": "Highlights"
        },
        "page_about_layout_who_we_are_04": {
            "value": "Batches Under 200 Jars",
            "label": "Highlight 2 - title",
            "group": "Highlights"
        },
        "page_about_layout_who_we_are_03": {
            "value": "No shortcuts. Every batch is tended by hand over gentle heat to prevent bitterness and ensure our garlic turns golden-crisp.",
            "label": "Highlight 2 - description",
            "group": "Highlights"
        },
        "page_about_layout_who_we_are_02": {
            "value": "“To us, spicy food isn't an endurance test. It's a multisensory spark that elevates every meal on your family table.”",
            "label": "Quote",
            "group": "Image and quote"
        },
        "page_about_layout_who_we_are_01": {
            "value": "— The Dried Chili Founding Team —",
            "label": "Quote attribution",
            "group": "Image and quote"
        },
        "page_about_layout_image_founders": {
            "value": "images/about_founders.jpg",
            "label": "Founders image",
            "type": "image",
            "group": "Image and quote"
        }
    },
