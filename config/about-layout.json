        "page_about_layout_why_trust_us_28": {
            "value": "WHY TRUST US · RADICAL TRANSPARENCY",
            "label": "Small label",
            "group": "Heading"
        },
        "page_about_layout_why_trust_us_27": {
            "value": "Radical Transparency",
            "label": "Title - first line",
            "group": "Heading"
        },
        "page_about_layout_why_trust_us_26": {
            "value": "Full Accountability In Every Single Jar",
            "label": "Title - second line",
            "group": "Heading"
        },
        "page_about_layout_why_trust_us_25": {
            "value": "We understand that spices go directly into the food you prepare for yourself and your loved ones. Real trust isn't earned through advertising, but through transparent actions and strict standards.",
            "label": "Introduction",
            "group": "Heading"
        },
        "page_about_layout_why_trust_us_24": {
            "value": "150K+",
            "label": "Number badge",
            "group": "Customer trust"
        },
        "page_about_layout_why_trust_us_23": {
            "value": "150,000+ Jars Delivered",
            "label": "Title",
            "group": "Customer trust"
        },
        "page_about_layout_why_trust_us_22": {
            "value": "Embraced in tens of thousands of home kitchens and relied upon by over 120 restaurants and food creators. Supported by an 84%+ repeat order rate from loyal customers.",
            "label": "Description",
            "group": "Customer trust"
        },
        "page_about_layout_why_trust_us_21": {
            "value": "4.9 / 5.0 Average Customer Rating",
            "label": "Footer text",
            "group": "Customer trust"
        },
        "page_about_layout_why_trust_us_20": {
            "value": "Direct-Trade Farm Partners",
            "label": "Title",
            "group": "Farm partners"
        },
        "page_about_layout_why_trust_us_19": {
            "value": "We collaborate directly with family farming collectives who practice sustainable agriculture. We pay fair prices above market benchmarks, ensuring clean crops and full origin traceability.",
            "label": "Description",
            "group": "Farm partners"
        },
        "page_about_layout_why_trust_us_18": {
            "value": "100% Traceable ingredient supply chain",
            "label": "Footer text",
            "group": "Farm partners"
        },
        "page_about_layout_why_trust_us_17": {
            "value": "The Strict \"3-NO\" Standard",
            "label": "Title",
            "group": "Quality standards"
        },
        "page_about_layout_why_trust_us_16": {
            "value": "Your health is our red line. We refuse to compromise on quality:",
            "label": "Introduction",
